# Environnement virtuel Python
.venv/

# Fichiers générés automatiquement par Python
__pycache__/
*.py[cod]

# Fichiers propres à macOS
.DS_Store

# Fichiers temporaires de travail
tmp/

# Configuration locale pouvant contenir des secrets
.env

# Clé Django propre à cet ordinateur
.django-secret-key

# Bases SQLite : fichiers de travail, pas la base livrable
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
